{
  "label": "\\A[a-z0-9_-]+\\z",
  "prefix": "\\A([A-Za-z]+:)+",
  "min_length": 4,
  "forms": {
    "email": {
      "pattern": "\\A[a-z0-9._+-]+@[a-z0-9.-]+\\z",
      "says": "a bare email address in lower-case ASCII"
    },
    "person": {
      "pattern": "\\A(group|user):[a-z0-9._+-]+@[a-z0-9.-]+\\z",
      "says": "group: or user: before an address, in lower-case ASCII; a service account, workload identity principal or domain gets its own Terraform resource"
    }
  },
  "stacks": {
    "ai": {
      "mcp_token_readers": {"form": "person", "min": 0},
      "studio_token_readers": {"form": "person", "min": 0}
    },
    "apis": {
      "invokers": {"form": "person", "min": 0}
    },
    "foundation": {
      "applier_impersonators": {"form": "person", "min": 0},
      "budget_alerts": {"form": "email", "min": 0},
      "ingestion_operators": {"form": "person", "min": 0}
    },
    "telemetry": {
      "alerts": {"form": "email", "min": 1},
      "readers": {"form": "person", "min": 0}
    }
  }
}
